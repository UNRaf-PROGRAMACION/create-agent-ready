{
  "name": "create-agent-ready-unraf",
  "version": "0.1.1",
  "description": "Prepare an existing project for agent-guided development and Spec-Driven Development.",
  "type": "module",
  "bin": {
    "create-agent-ready-unraf": "bin/create-agent-ready-unraf.js"
  },
  "files": [
