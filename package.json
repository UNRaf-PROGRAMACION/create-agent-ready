    "src/autoskills.js",
    "src/doctor.js",
    "src/scaffold.js",
    "src/templates.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test",
