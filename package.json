  },
  "homepage": "https://unraf-programacion.github.io/create-agent-ready/",
  "keywords": [
    "agents",
    "agentic-development",
    "sdd",
    "spec-driven-development",
    "opencode",
    "videogames"
  ],
  "license": "MIT",
