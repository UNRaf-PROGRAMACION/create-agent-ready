    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UNRaf-PROGRAMACION/create-agent-ready.git"
  },
  "bugs": {
